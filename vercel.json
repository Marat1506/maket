{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --prefer-offline --no-audit",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/str3",
      "destination": "/index3.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}